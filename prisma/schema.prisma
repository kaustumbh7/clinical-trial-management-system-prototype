generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Study {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  status    String   @default("ACTIVE") // DRAFT | ACTIVE | CLOSED
  createdAt DateTime @default(now())

  arms          StudyArm[]
  timepoints    Timepoint[]
  templates     SoeTaskTemplate[]
  participants  Participant[]
  screeners     ScreenerResponse[]
  kitSkus       KitSku[]
  paymentRules  PaymentRule[]
  budgetLines   BudgetLine[]
  aeTemplates   AeReportTemplate[]
  adverseEvents AdverseEvent[]
  appointments  Appointment[]
  regDocs       RegulatoryDocument[]
}

model StudyArm {
  id       String @id @default(cuid())
  studyId  String
  name     String
  capacity Int    @default(50)

  study        Study         @relation(fields: [studyId], references: [id], onDelete: Cascade)
  participants Participant[]
}

model Timepoint {
  id        String @id @default(cuid())
  studyId   String
  name      String
  dayOffset Int

  study     Study             @relation(fields: [studyId], references: [id], onDelete: Cascade)
  templates SoeTaskTemplate[]
}

model SoeTaskTemplate {
  id                  String  @id @default(cuid())
  studyId             String
  timepointId         String?
  name                String
  description         String?
  // CONSENT | SURVEY | VISIT | REMINDER | KIT_SHIP | KIT_ACTIVATE | SAMPLE_COLLECT | SAMPLE_RETURN
  kind                String
  triggerType         String // TIME | COMPLETION | MANUAL | WEBHOOK
  dependsOnTemplateId String?
  reminderOffsetDays  Int?
  sortOrder           Int     @default(0)

  study         Study          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  timepoint     Timepoint?     @relation(fields: [timepointId], references: [id])
  taskInstances TaskInstance[]
}

model Participant {
  id         String    @id @default(cuid())
  studyId    String
  armId      String?
  name       String
  email      String
  status     String    @default("LEAD") // LEAD | SCREENED | CONSENTED | ENROLLED | WITHDRAWN | COMPLETED
  enrolledAt DateTime?
  createdAt  DateTime  @default(now())

  study            Study              @relation(fields: [studyId], references: [id], onDelete: Cascade)
  arm              StudyArm?          @relation(fields: [armId], references: [id])
  consents         ConsentRecord[]
  tasks            TaskInstance[]
  kits             Kit[]
  samples          Sample[]
  paymentEvents    PaymentEvent[]
  adverseEvents    AdverseEvent[]
  appointments     Appointment[]
  staffAssignments StaffAssignment[]

  @@index([studyId, status])
}

model ScreenerResponse {
  id        String   @id @default(cuid())
  studyId   String
  leadName  String
  leadEmail String
  answers   String
  outcome   String // QUALIFIED | DISQUALIFIED | WAITLIST
  createdAt DateTime @default(now())

  study Study @relation(fields: [studyId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id            String   @id @default(cuid())
  participantId String
  version       String   @default("v1.0")
  signedAt      DateTime @default(now())
  signatureName String
  pdfBlobPath   String

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model TaskInstance {
  id            String    @id @default(cuid())
  participantId String
  templateId    String
  status        String    @default("PENDING") // PENDING | DUE | COMPLETED | OVERDUE | SKIPPED
  dueAt         DateTime
  availableAt   DateTime
  completedAt   DateTime?
  payload       String?

  participant Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  template    SoeTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([participantId, status])
}

model AuditEvent {
  id         String   @id @default(cuid())
  ts         DateTime @default(now())
  actorKind  String // STAFF | PARTICIPANT | SYSTEM
  actorId    String?
  actorLabel String?
  action     String
  targetType String
  targetId   String
  studyId    String?
  metadata   String?

  @@index([ts])
  @@index([studyId, ts])
}

model SimClock {
  id          String   @id @default("singleton")
  currentDate DateTime
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Logistics — Kits, Inventory, Shipments, Samples (Group A)
// ---------------------------------------------------------------------------

model KitSku {
  id            String @id @default(cuid())
  studyId       String
  code          String
  name          String
  vendor        String?
  expiryMonths  Int     @default(24)

  study Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  lots  KitLot[]

  @@unique([studyId, code])
}

model KitLot {
  id              String   @id @default(cuid())
  skuId           String
  lotNumber       String
  quantityOnHand  Int      @default(0)
  threshold       Int      @default(10)
  expiryAt        DateTime?
  receivedAt      DateTime @default(now())

  sku  KitSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  kits Kit[]

  @@unique([skuId, lotNumber])
}

model Kit {
  id            String   @id @default(cuid())
  lotId         String
  participantId String?
  // ALLOCATED | SHIPPED | DELIVERED | ACTIVATED | RETURN_SHIPPED | RETURNED | LOST
  status        String   @default("ALLOCATED")
  qrToken       String   @unique
  allocatedAt   DateTime @default(now())
  activatedAt   DateTime?

  lot         KitLot       @relation(fields: [lotId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id])
  shipments   Shipment[]
  samples     Sample[]

  @@index([participantId, status])
}

model Shipment {
  id             String   @id @default(cuid())
  kitId          String
  direction      String   // OUTBOUND | RETURN
  carrier        String
  trackingNumber String   @unique
  // CREATED | IN_TRANSIT | DELIVERED | LOST
  status         String   @default("CREATED")
  labelPath      String?
  createdAt      DateTime @default(now())
  deliveredAt    DateTime?

  kit Kit @relation(fields: [kitId], references: [id], onDelete: Cascade)
}

model Sample {
  id            String    @id @default(cuid())
  kitId         String
  participantId String
  timepointId   String?
  tubeBarcode   String    @unique
  collectedAt   DateTime?
  intakeAt      DateTime?
  condition     String?   // GOOD | DEGRADED | LOST | UNUSABLE
  notes         String?

  kit         Kit         @relation(fields: [kitId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Money — Payments rules + ledger + Budget (Group B)
// ---------------------------------------------------------------------------

model PaymentRule {
  id               String  @id @default(cuid())
  studyId          String
  name             String
  // TASK_COMPLETED | TIMEPOINT_REACHED | KIT_RETURNED
  trigger          String
  templateId       String? // if trigger=TASK_COMPLETED, the SoeTaskTemplate id
  timepointId      String? // if trigger=TIMEPOINT_REACHED
  amountCents      Int
  currency         String  @default("USD")
  settlementGated  Boolean @default(false)
  active           Boolean @default(true)

  study  Study          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  events PaymentEvent[]
}

// Append-only — status transitions are recorded by inserting a *new* row
// in production. For prototype simplicity we update the row but never delete.
model PaymentEvent {
  id            String   @id @default(cuid())
  participantId String
  ruleId        String
  // PENDING | SETTLED | FAILED | VOIDED
  status        String   @default("PENDING")
  amountCents   Int
  currency      String   @default("USD")
  processorRef  String   @unique // idempotency key for mock Stripe
  requestedAt   DateTime @default(now())
  settledAt     DateTime?
  failureReason String?

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  rule        PaymentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([ruleId])
  @@index([status])
}

model BudgetLine {
  id           String   @id @default(cuid())
  studyId      String
  category     String   // e.g. "Participant compensation", "Shipping", "Lab", "Staff"
  description  String?
  plannedCents Int
  createdAt    DateTime @default(now())

  study Study @relation(fields: [studyId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Clinical Operations — AE, Appointments, Regulatory Docs (Group C)
// ---------------------------------------------------------------------------

model AeReportTemplate {
  id               String  @id @default(cuid())
  studyId          String
  name             String
  fields           String  // JSON-stringified field schema (label, type, options)
  autoStreamPause  Boolean @default(true)
  active           Boolean @default(true)
  createdAt        DateTime @default(now())

  study  Study          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  events AdverseEvent[]
}

model AdverseEvent {
  id            String   @id @default(cuid())
  studyId       String
  participantId String
  templateId    String
  // MILD | MODERATE | SERIOUS
  severity      String
  // REPORTED | TRIAGED | RESOLVED | CLOSED
  status        String   @default("REPORTED")
  fields        String   // JSON-stringified participant answers
  photoPaths    String?  // JSON array of paths
  summary       String?
  reportedAt    DateTime @default(now())
  triagedAt     DateTime?
  resolvedAt    DateTime?
  closedAt      DateTime?
  resolution    String?

  study       Study             @relation(fields: [studyId], references: [id], onDelete: Cascade)
  participant Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  template    AeReportTemplate  @relation(fields: [templateId], references: [id])

  @@index([studyId, status])
  @@index([participantId])
}

model Appointment {
  id            String   @id @default(cuid())
  studyId       String
  participantId String
  // IN_PERSON | E_VISIT | VIDEO — VIDEO reserved as the telehealth seam, not implemented yet
  modality      String
  scheduledAt   DateTime
  durationMin   Int      @default(30)
  staffLabel    String?
  // SCHEDULED | COMPLETED | CANCELED | NO_SHOW
  status        String   @default("SCHEDULED")
  notes         String?
  joinUrl       String?
  createdAt     DateTime @default(now())

  study       Study       @relation(fields: [studyId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([studyId, scheduledAt])
}

// ---------------------------------------------------------------------------
// Staff directory + assignment + internal notes (Group D)
// ---------------------------------------------------------------------------

model StaffUser {
  id    String @id @default(cuid())
  name  String
  email String @unique
  // PI | COORDINATOR | OPS | FINANCE | AUDITOR | READONLY
  role  String

  assignments StaffAssignment[]
  notes       InternalNote[]
}

model StaffAssignment {
  id            String @id @default(cuid())
  participantId String
  staffId       String
  // PRIMARY_COORDINATOR | BACKUP | INVESTIGATOR
  role          String @default("PRIMARY_COORDINATOR")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staff       StaffUser   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([participantId, staffId, role])
  @@index([staffId])
}

model InternalNote {
  id           String   @id @default(cuid())
  targetType   String   // Participant | Kit | AdverseEvent | Appointment | PaymentEvent | Study
  targetId     String
  authorId     String
  body         String
  mentions     String?  // JSON array of staff ids
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  author StaffUser @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
}

model RegulatoryDocument {
  id           String   @id @default(cuid())
  studyId      String
  // IRB | PROTOCOL | CONSENT_TEMPLATE | SOP | OTHER
  type         String
  title        String
  version      String   @default("v1.0")
  supersedesId String?
  filePath     String
  uploadedBy   String?
  uploadedAt   DateTime @default(now())
  notes        String?

  study      Study                @relation(fields: [studyId], references: [id], onDelete: Cascade)
  supersedes RegulatoryDocument?  @relation("DocChain", fields: [supersedesId], references: [id])
  supersedeBy RegulatoryDocument[] @relation("DocChain")

  @@index([studyId, type])
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Study {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  status    String   @default("ACTIVE") // DRAFT | ACTIVE | CLOSED
  createdAt DateTime @default(now())

  arms         StudyArm[]
  timepoints   Timepoint[]
  templates    SoeTaskTemplate[]
  participants Participant[]
  screeners    ScreenerResponse[]
  kitSkus      KitSku[]
}

model StudyArm {
  id       String @id @default(cuid())
  studyId  String
  name     String
  capacity Int    @default(50)

  study        Study         @relation(fields: [studyId], references: [id], onDelete: Cascade)
  participants Participant[]
}

model Timepoint {
  id        String @id @default(cuid())
  studyId   String
  name      String
  dayOffset Int

  study     Study             @relation(fields: [studyId], references: [id], onDelete: Cascade)
  templates SoeTaskTemplate[]
}

model SoeTaskTemplate {
  id                  String  @id @default(cuid())
  studyId             String
  timepointId         String?
  name                String
  description         String?
  // CONSENT | SURVEY | VISIT | REMINDER | KIT_SHIP | KIT_ACTIVATE | SAMPLE_COLLECT | SAMPLE_RETURN
  kind                String
  triggerType         String // TIME | COMPLETION | MANUAL | WEBHOOK
  dependsOnTemplateId String?
  reminderOffsetDays  Int?
  sortOrder           Int     @default(0)

  study         Study          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  timepoint     Timepoint?     @relation(fields: [timepointId], references: [id])
  taskInstances TaskInstance[]
}

model Participant {
  id         String    @id @default(cuid())
  studyId    String
  armId      String?
  name       String
  email      String
  status     String    @default("LEAD") // LEAD | SCREENED | CONSENTED | ENROLLED | WITHDRAWN | COMPLETED
  enrolledAt DateTime?
  createdAt  DateTime  @default(now())

  study    Study           @relation(fields: [studyId], references: [id], onDelete: Cascade)
  arm      StudyArm?       @relation(fields: [armId], references: [id])
  consents ConsentRecord[]
  tasks    TaskInstance[]
  kits     Kit[]
  samples  Sample[]

  @@index([studyId, status])
}

model ScreenerResponse {
  id        String   @id @default(cuid())
  studyId   String
  leadName  String
  leadEmail String
  answers   String
  outcome   String // QUALIFIED | DISQUALIFIED | WAITLIST
  createdAt DateTime @default(now())

  study Study @relation(fields: [studyId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id            String   @id @default(cuid())
  participantId String
  version       String   @default("v1.0")
  signedAt      DateTime @default(now())
  signatureName String
  pdfBlobPath   String

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model TaskInstance {
  id            String    @id @default(cuid())
  participantId String
  templateId    String
  status        String    @default("PENDING") // PENDING | DUE | COMPLETED | OVERDUE | SKIPPED
  dueAt         DateTime
  availableAt   DateTime
  completedAt   DateTime?
  payload       String?

  participant Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  template    SoeTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([participantId, status])
}

model AuditEvent {
  id         String   @id @default(cuid())
  ts         DateTime @default(now())
  actorKind  String // STAFF | PARTICIPANT | SYSTEM
  actorId    String?
  actorLabel String?
  action     String
  targetType String
  targetId   String
  studyId    String?
  metadata   String?

  @@index([ts])
  @@index([studyId, ts])
}

model SimClock {
  id          String   @id @default("singleton")
  currentDate DateTime
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Logistics — Kits, Inventory, Shipments, Samples (Group A)
// ---------------------------------------------------------------------------

model KitSku {
  id            String @id @default(cuid())
  studyId       String
  code          String
  name          String
  vendor        String?
  expiryMonths  Int     @default(24)

  study Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  lots  KitLot[]

  @@unique([studyId, code])
}

model KitLot {
  id              String   @id @default(cuid())
  skuId           String
  lotNumber       String
  quantityOnHand  Int      @default(0)
  threshold       Int      @default(10)
  expiryAt        DateTime?
  receivedAt      DateTime @default(now())

  sku  KitSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  kits Kit[]

  @@unique([skuId, lotNumber])
}

model Kit {
  id            String   @id @default(cuid())
  lotId         String
  participantId String?
  // ALLOCATED | SHIPPED | DELIVERED | ACTIVATED | RETURN_SHIPPED | RETURNED | LOST
  status        String   @default("ALLOCATED")
  qrToken       String   @unique
  allocatedAt   DateTime @default(now())
  activatedAt   DateTime?

  lot         KitLot       @relation(fields: [lotId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id])
  shipments   Shipment[]
  samples     Sample[]

  @@index([participantId, status])
}

model Shipment {
  id             String   @id @default(cuid())
  kitId          String
  direction      String   // OUTBOUND | RETURN
  carrier        String
  trackingNumber String   @unique
  // CREATED | IN_TRANSIT | DELIVERED | LOST
  status         String   @default("CREATED")
  labelPath      String?
  createdAt      DateTime @default(now())
  deliveredAt    DateTime?

  kit Kit @relation(fields: [kitId], references: [id], onDelete: Cascade)
}

model Sample {
  id            String    @id @default(cuid())
  kitId         String
  participantId String
  timepointId   String?
  tubeBarcode   String    @unique
  collectedAt   DateTime?
  intakeAt      DateTime?
  condition     String?   // GOOD | DEGRADED | LOST | UNUSABLE
  notes         String?

  kit         Kit         @relation(fields: [kitId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}
